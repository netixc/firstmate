#!/usr/bin/env bash
set -eu
root=${FM_HOME:?}
command=${1:-}
case "$command" in
  show)
    id=${2:?}
    cat "$root/records/$id.md"
    ;;
  update)
    id=${2:?}
    shift 2
    body_file=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --body-file) body_file=${2:?}; shift 2 ;;
        --archive-body) shift ;;
        *) shift ;;
      esac
    done
    [ -n "$body_file" ]
    cp "$body_file" "$root/records/$id.md"
    printf 'updated=%s\n' "$id"
    ;;
  *)
    printf 'unsupported tasks-axi command: %s\n' "$command" >&2
    exit 2
    ;;
esac
